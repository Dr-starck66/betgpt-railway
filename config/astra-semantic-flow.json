{
  "version": "ASTRA-SEMANTIC-FLOW-1",
  "routeDirs": ["src/routes"],
  "corpusDirs": ["src"],
  "extensions": [".tsx", ".ts", ".jsx", ".js"],
  "ignoreFiles": ["src/routeTree.gen.ts"],
  "cannibalizationThreshold": 0.94,
  "intentCannibalizationThreshold": 0.9,
  "semanticJumpThreshold": 0.05,
  "glideMin": 0.12,
  "glideMax": 0.84,
  "orphanMode": "partial",
  "strategicRoutes": [
    "/scores-en-direct",
    "/resultats-football",
    "/comparer-cotes",
    "/pronostics-sportifs",
    "/ledger",
    "/rapports/precision"
  ],
  "reportPath": "artifacts/seo/semantic-flow.json",
  "maxPrintedRecommendations": 25
}
