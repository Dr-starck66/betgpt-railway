{
  "schema": "astra-never-fail-build-guard/v1",
  "reportPath": "artifacts/release/never-fail-build.json",
  "requiredChecks": [
    {
      "id": "prebuild-guards",
      "command": "npm run prebuild"
    },
    {
      "id": "self-heal-tests",
      "command": "npm run test:self-heal"
    },
    {
      "id": "indexability-release",
      "command": "npm run seo:indexability-release"
    },
    {
      "id": "typecheck",
      "command": "npm run typecheck"
    },
    {
      "id": "repair-tests",
      "command": "npm run test:repairs"
    },
    {
      "id": "affiliate-conversion",
      "command": "npm run affiliate:guard"
    },
    {
      "id": "stream-resilience",
      "command": "npm run guard:stream-resilience"
    },
    {
      "id": "results-watchdog",
      "command": "npm run test:results-watchdog"
    },
    {
      "id": "learning-memory",
      "command": "npm run test:learning-memory"
    },
    {
      "id": "roi5-continuous",
      "command": "npm run test:roi5-continuous"
    },
    {
      "id": "search-truth",
      "command": "npm run test:search-truth"
    },
    {
      "id": "national-breakout",
      "command": "npm run test:growth"
    },
    {
      "id": "production-bundle",
      "command": "npm run build"
    }
  ],
  "extendedChecks": [
    {
      "id": "full-test-suite",
      "command": "npm test"
    }
  ],
  "policy": {
    "failClosed": true,
    "productionPromotionRequiresGreenCandidate": true,
    "keepLastHealthyProductionOnBlock": true,
    "neverPromoteFromWorkingTree": true,
    "immutableCommitOnly": true,
    "streamRecoveryRequired": true,
    "resumeFromDurableCheckpoint": true,
    "affiliateTrackingRequired": true,
    "affiliateFalseMonetizationForbidden": true
  }
}
