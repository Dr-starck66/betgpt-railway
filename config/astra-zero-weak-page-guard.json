{
  "version": "ASTRA-ZERO-WEAK-PAGE-GUARD-2",
  "routeDirs": [
    "src/routes"
  ],
  "extensions": [
    ".tsx",
    ".ts",
    ".jsx",
    ".js"
  ],
  "ignoreFiles": [],
  "technicalPatterns": [
    "src/routes/admin",
    "src/routes/go.tsx$",
    "src/routes/geo-health.tsx$",
    "src/routes/lab.tsx$",
    "src/routes/portefeuille-mots-cles.tsx$"
  ],
  "headDelegatePatterns": [
    "leagueHead\\(",
    "matchHead\\(",
    "geoCanonical\\(",
    "doc\\.title",
    "doc\\.description"
  ],
  "contentDelegatePatterns": [
    "<GeoArticle",
    "<CupPage",
    "<ResultsBoard",
    "<ScoresHub",
    "<MatchDetail",
    "<MatchArticle",
    "<NewsArticle",
    "<BlogBody",
    "<ScoreTable",
    "<LegalLayout",
    "<ActuFeed",
    "<ZeroRadarView",
    "<PronoSilo"
  ],
  "minInternalLinks": 2,
  "minScore": 78,
  "sitemapSource": "src/lib/sitemap-urls.ts",
  "reportPath": "artifacts/seo/zero-weak-pages.json",
  "roleMinimums": {
    "legal": 68,
    "trust": 78,
    "commercial": 78,
    "editorial": 78,
    "entity": 78,
    "landing": 78,
    "layout": 0,
    "technical": 0,
    "redirect": 0
  },
  "minVisibleTextBytes": 450,
  "enforceUniqueMetadata": true
}
