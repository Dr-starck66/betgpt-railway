{
  "name": "BetGPT remote production verification",
  "defaults": {
    "timeoutMs": 30000,
    "retries": 4,
    "retryDelayMs": 4000,
    "excerptChars": 1500
  },
  "targets": [
    {
      "id": "public-domain",
      "provider": "public",
      "url": "https://betgpt.live",
      "priority": 10,
      "fallback": false
    },
    {
      "id": "railway-origin",
      "provider": "railway",
      "url": "https://betgpt-production-7353.up.railway.app",
      "priority": 90,
      "fallback": true
    }
  ],
  "probes": [
    {
      "id": "health",
      "method": "GET",
      "path": "/api/health",
      "expect": {
        "statuses": [
          200
        ]
      }
    },
    {
      "id": "ledger-sidewings",
      "method": "GET",
      "path": "/ledger",
      "expect": {
        "statuses": [
          200
        ],
        "text": {
          "requireAll": [
            "Bilan BetGPT",
            "Comprendre le bilan",
            "Lire les chiffres correctement"
          ]
        }
      }
    },
    {
      "id": "tools-sidewings",
      "method": "GET",
      "path": "/outils",
      "expect": {
        "statuses": [
          200
        ],
        "text": {
          "requireAll": [
            "Calculateurs football et paris",
            "Comprendre avant de calculer",
            "Du calcul au contexte réel"
          ]
        }
      }
    },
    {
      "id": "results-watchdog",
      "method": "GET",
      "path": "/api/results-watchdog",
      "expect": {
        "statuses": [
          200
        ],
        "text": {
          "requireAll": [
            "astra-results-watchdog/v1",
            "\"status\":\"PASS\"",
            "\"FotMob\"",
            "\"ESPN\"",
            "\"BetGPT archive\"",
            "\"BetGPT desk\""
          ]
        }
      }
    },
    {
      "id": "calendar-sidewings",
      "method": "GET",
      "path": "/calendrier/ligue-1",
      "expect": {
        "statuses": [
          200
        ],
        "text": {
          "requireAll": [
            "Explorer Ligue 1",
            "Du calendrier au match"
          ]
        }
      }
    },
    {
      "id": "stats-high-sidewings",
      "method": "GET",
      "path": "/statistics/leagues/highest-0-0",
      "expect": {
        "statuses": [
          200
        ],
        "text": {
          "requireAll": [
            "Explorer les statistiques",
            "Interpréter le signal"
          ]
        }
      }
    },
    {
      "id": "stats-low-sidewings",
      "method": "GET",
      "path": "/statistics/leagues/lowest-0-0",
      "expect": {
        "statuses": [
          200
        ],
        "text": {
          "requireAll": [
            "Explorer les statistiques",
            "Interpréter le signal"
          ]
        }
      }
    },
    {
      "id": "daily-news-sidewings",
      "method": "GET",
      "path": "/actu/2026-10-01",
      "expect": {
        "statuses": [
          200
        ],
        "text": {
          "requireAll": [
            "Autour de l’actu du jour",
            "Vérifier et approfondir"
          ]
