{
  "schema": "astra-indexability-release-gate/v1",
  "zeroWeakReport": "artifacts/seo/zero-weak-pages.json",
  "sitemapSource": "src/lib/sitemap-urls.ts",
  "reportPath": "artifacts/seo/indexability-release-gate.json",
  "failOnDuplicateLiteralPaths": true,
  "ignoreRoutes": [],
  "dynamicCoverage": [
    {
      "routePattern": "^/actu/:day$",
      "sitemapSource": "src/lib/sitemap-urls.ts",
      "requiredFragments": [
        "/actu/${today}"
      ]
    },
    {
      "routePattern": "^/equipe/:team$",
      "sitemapSource": "src/lib/sitemap-urls.ts",
      "requiredFragments": [
        "teamPath(name)"
      ]
    },
    {
      "routePattern": "^/prediction/:predictionId$",
      "sitemapSource": "src/lib/sitemap-urls.ts",
      "requiredFragments": [
        "/prediction/",
        "stablePublicEvidenceTickets"
      ]
    },
    {
      "routePattern": "^/(guides(?:/:slug)?|outils(?:/:slug)?|meilleur-site-pronostic|pronostics-football(?:/:league)?)$",
      "sitemapSource": "src/lib/sitemap-urls.ts",
      "requiredFragments": [
        "moneySitemapPaths"
      ]
    },
    {
      "routePattern": "^/pronostics-football/aujourdhui$",
      "sitemapSource": "src/lib/sitemap-urls.ts",
      "requiredFragments": [
        "/pronostics-football/aujourdhui"
      ]
    },
    {
      "routePattern": "^/pronostics-football/demain$",
      "sitemapSource": "src/lib/sitemap-urls.ts",
      "requiredFragments": [
        "/pronostics-football/demain"
      ]
    },
    {
      "routePattern": "^/resultats-football/:league$",
      "sitemapSource": "src/lib/sitemap-urls.ts",
      "requiredFragments": [
        "SERP_COMPETITIONS",
        "resultsPath",
        "loadResultsBoardData",
        "resultLeafPaths"
      ]
    },
    {
      "routePattern": "^/scores-en-direct/:league$",
      "sitemapSource": "src/lib/sitemap-urls.ts",
      "requiredFragments": [
        "SERP_COMPETITIONS",
        "scoresPath"
      ]
    },
    {
      "routePattern": "^/(ligue-1|premier-league|la-liga|bundesliga|serie-a|ligue-des-champions|ligue-europa)$",
      "sitemapSource": "src/lib/sitemap-urls.ts",
      "requiredFragments": [
        "LEAGUE_HUBS"
      ]
    },
    {
      "routePrefix": "/match",
      "sitemapSource": "src/lib/sitemap-urls.ts",
      "requiredFragments": [
        "/match/"
      ]
    },
    {
      "routePrefix": "/forum",
      "sitemapSource": "src/lib/sitemap-urls.ts",
      "requiredFragments": [
        "/forum/"
      ]
    },
    {
      "routePrefix": "/cotes",
      "sitemapSource": "src/lib/sitemap-urls.ts",
      "requiredFragments": [
        "/cotes/"
      ]
    },
    {
      "routePrefix": "/blog",
      "sitemapSource": "src/lib/sitemap-urls.ts",
      "requiredFragments": [
        "/blog/"
      ]
    },
    {
      "routePrefix": "/actualites",
      "sitemapSource": "src/lib/sitemap-urls.ts",
      "requiredFragments": [
        "classicNewsPaths"
      ]
    },
    {
      "routePrefix": "/classement",
      "sitemapSource": "src/lib/sitemap-urls.ts",
      "requiredFragments": [
        "/classement/"
      ]
    },
    {
      "routePrefix": "/calendrier",
      "sitemapSource": "src/lib/sitemap-urls.ts",
      "requiredFragments": [
        "/calendrier/"
      ]
    },
    {
      "routePrefix": "/statistics",
      "sitemapSource": "src/lib/sitemap-urls.ts",
      "requiredFragments": [
        "/statistics/"
      ]
    },
    {
      "routePrefix": "/score-hunter",
      "sitemapSource": "src/lib/sitemap-urls.ts",
      "requiredFragments": [
        "/score-hunter/"
      ]
    },
    {
      "routePrefix": "/auteurs/betgpt-editorial",
      "sitemapSource": "src/lib/sitemap-urls.ts",
      "requiredFragments": [
        "/auteurs/betgpt-editorial"
      ]
    }
  ],
  "routeAliases": {
    "/auteurs_/betgpt-editorial": "/auteurs/betgpt-editorial"
  }
}
