{
  "name": "BetGPT production route gate",
  "revisionPath": "/api/astra-revision",
  "wait": {
    "timeoutMs": 720000,
    "intervalMs": 10000,
    "requestTimeoutMs": 15000
  },
  "targets": [
    {
      "id": "public-domain",
      "role": "public",
      "url": "https://betgpt.live"
    },
    {
      "id": "railway-origin",
      "role": "origin",
      "url": "https://betgpt-production-7353.up.railway.app"
    }
  ],
  "probes": [
    {
      "id": "home",
      "method": "GET",
      "path": "/",
      "expect": {
        "statuses": [
          200
        ]
      }
    },
    {
      "id": "gif-asset",
      "method": "GET",
      "path": "/reactions/astra-shock.gif?v=route-gate",
      "expect": {
        "statuses": [
          200
        ]
      }
    },
    {
      "id": "daily-pick-chat",
      "method": "POST",
      "path": "/api/chat",
      "body": {
        "messages": [
          {
            "role": "user",
            "content": "Qu'est-ce que tu mises aujourd'hui, et pourquoi ?"
          }
        ],
        "requestedMode": "NORMAL"
      },
      "expect": {
        "statuses": [
          200
        ],
        "jsonPath": "text",
        "jsonText": {
          "forbid": [
            "donne-moi les affiches",
            "donne moi les affiches"
          ]
        }
      }
    },
    {
      "id": "prono-ligue-1",
      "method": "GET",
      "path": "/pronostics-football/ligue-1",
      "expect": {
        "statuses": [
          200
        ],
        "text": {
          "requireAll": [
            "Pronostic Ligue 1",
            "Pronostics Ligue 1 : la page reste utile même entre deux journées",
            "Comment lire un pronostic Ligue 1"
          ]
        }
      }
    },
    {
      "id": "prono-premier-league",
      "method": "GET",
      "path": "/pronostics-football/premier-league",
      "expect": {
        "statuses": [
          200
