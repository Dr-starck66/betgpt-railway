{
  "name": "app-builder-workspace",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "overrides": {
    "nf3": "0.3.17"
  },
  "scripts": {
    "dev": "node scripts/with-app-env.mjs vite dev --host 0.0.0.0 --port 8080",
    "build": "node scripts/with-app-env.mjs vite build && npm run db:migrate",
    "prebuild": "node scripts/clean-build.mjs && node scripts/astra-flag-guard.mjs && node scripts/astra-model-max-guard.mjs && node scripts/astra-visual-entity-guard.mjs && node scripts/astra-zero-weak-page-guard.mjs --strict && node --experimental-strip-types --import ./scripts/ts-alias.mjs scripts/astra-heading-architecture-guard.mjs --strict",
    "prebuild:dev": "node scripts/clean-build.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "build:dev": "node scripts/with-app-env.mjs vite build --mode development",
    "preview": "node scripts/with-app-env.mjs vite preview",
    "preview:restart": "node scripts/preview.mjs restart",
    "preview:stop": "node scripts/preview.mjs stop",
    "typecheck": "tsc --noEmit",
    "test:repairs": "node --experimental-strip-types --import ./scripts/ts-alias.mjs --test src/lib/chat/chat.test.ts src/engine/bet-safety.test.ts src/engine/article.test.ts",
    "verify:dev": "node scripts/verify-local.mjs --all",
    "verify:production": "node scripts/verify-local.mjs --production",
    "check:auth": "node scripts/check-auth-invariant.mjs",
    "test": "node --test 'scripts/**/*.test.mjs' && node --experimental-strip-types --import ./scripts/ts-alias.mjs --test src/lib/app-data/app-data.test.ts src/lib/auth/gate-identity.test.ts src/lib/auth/sign-in-gate.test.ts src/engine/stats.test.ts src/engine/hunter.test.ts src/engine/archive.test.ts src/engine/guard.test.ts src/lib/legal.test.ts src/lib/store.test.ts src/lib/markets.test.ts src/engine/verify.test.ts src/engine/ledger-stats.test.ts src/engine/settle.test.ts src/engine/ticket-log.test.ts src/engine/live-intel.test.ts src/engine/article.test.ts src/engine/team-form.test.ts src/lib/match-clock.test.ts src/lib/seo.test.ts src/lib/serp/serp.test.ts src/lib/seo/money-map.test.ts src/lib/geo/geo.test.ts src/engine/match-resolve.test.ts src/engine/match-intelligence-panel.test.ts src/engine/best-odds-engine.test.ts src/lib/editorial/editorial.test.ts src/lib/social/social.test.ts",
    "seo:audit": "node --experimental-strip-types --import ./scripts/ts-alias.mjs scripts/seo-audit.mjs",
    "seo:audit:production": "node --experimental-strip-types --import ./scripts/ts-alias.mjs scripts/seo-audit.mjs --production",
    "seo": "npm run seo:audit",
    "news": "node --experimental-strip-types --import ./scripts/ts-alias.mjs --test src/lib/editorial/editorial.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:adaptive-learning": "node --experimental-strip-types --test src/engine/adaptive-learning.test.ts",
    "learning:report": "node --experimental-strip-types scripts/run-adaptive-learning.mjs",
    "test:selective-hedge": "node --experimental-strip-types --test src/engine/selective-hedge.test.ts",
    "test:score-hedge": "node --experimental-strip-types --test src/engine/selective-score-hedge.test.ts",
    "test:hedge-profitability": "node --experimental-strip-types --test src/engine/hedge-profitability-gate.test.ts",
    "test:hedge-live-proof": "node --experimental-strip-types --test src/engine/exact-score-book-odds.test.ts src/engine/hedge-shadow-ledger.test.ts",
    "test:portfolio-learning": "node --experimental-strip-types --test src/engine/portfolio-lab.test.ts src/engine/continuous-portfolio-learning.test.ts",
    "portfolio:learn": "node --experimental-strip-types scripts/run-continuous-portfolio-learning.mjs",
    "portfolio:roi-floor": "node --experimental-strip-types --import ./scripts/ts-alias.mjs scripts/run-dynamic-roi-floor.mjs",
    "test:best-odds": "node --experimental-strip-types --test src/engine/best-odds-engine.test.ts",
    "test:xg-gates": "node --experimental-strip-types --test src/engine/low-scoring-no-bet-gate.test.ts src/engine/hedge-xg-eligibility.test.ts src/engine/xg-hedge-gate.test.ts src/engine/best-odds-engine.test.ts src/engine/no-bet-roi-exclusion.test.ts",
    "test:roi5-gate": "node --experimental-strip-types --test src/engine/roi5-dominance-gate.test.ts",
    "test:roi5-continuous": "node --experimental-strip-types --test src/engine/roi5-continuous-learning.test.ts",
    "test:league-expansion": "node --experimental-strip-types --import ./scripts/ts-alias.mjs --test src/engine/roi-league-expansion.test.ts",
    "roi5:report": "node --experimental-strip-types --import ./scripts/ts-alias.mjs scripts/run-dominance-roi-gate.mjs",
    "editorial:publish": "node --experimental-strip-types --import ./scripts/ts-alias.mjs scripts/run-editorial-publish.ts",
    "start": "node .output/server/index.mjs",
    "social:audit": "node --experimental-strip-types --import ./scripts/ts-alias.mjs --test src/lib/social/social.test.ts",
    "test:sidewings": "node --experimental-strip-types --test src/lib/seo/astra-sidewing-auditor.test.ts src/lib/seo/astra-sidewing-planner.test.ts",
    "sidewings:audit": "node --experimental-strip-types scripts/astra-sidewing-audit.mjs",
    "test:results-watchdog": "node --experimental-strip-types --import ./scripts/ts-alias.mjs --test src/lib/serp/results-watchdog.test.ts",
    "cloud:verify": "node scripts/astra-cloud-egress.mjs config/astra-cloud-egress.json",
    "cloud:verify:config": "node scripts/astra-cloud-egress.mjs config/astra-cloud-egress.json --validate-config",
    "test:flags": "node scripts/astra-flag-guard.mjs",
    "test:module-resolution": "node --experimental-strip-types --import ./scripts/ts-alias.mjs -e \"await import('./src/engine/live.ts'); console.log('ASTRA_MODULE_RESOLUTION_PASS')\"",
    "release:validate": "node scripts/astra-release-gate.mjs validate",
    "release:preflight": "node scripts/astra-release-gate.mjs preflight",
    "release:postflight": "node scripts/astra-release-gate.mjs postflight",
    "release:pipeline:editorial": "node scripts/astra-release-gate.mjs pipeline editorial",
    "test:model-max": "node scripts/astra-model-max-guard.mjs && node --experimental-strip-types --import ./scripts/ts-alias.mjs --test src/lib/ai/astra-model-max.test.ts",
    "test:visual-entities": "node scripts/astra-visual-entity-guard.mjs",
    "seo:zero-weak": "node scripts/astra-zero-weak-page-guard.mjs --strict",
    "seo:headings": "node --experimental-strip-types --import ./scripts/ts-alias.mjs scripts/astra-heading-architecture-guard.mjs --strict",
    "release:candidate": "node scripts/astra-never-fail-build-guard.mjs",
    "release:candidate:extended": "node scripts/astra-never-fail-build-guard.mjs --extended"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
