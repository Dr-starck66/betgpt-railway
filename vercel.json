{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "crons": [
    { "path": "/api/editorial-run", "schedule": "0 6 * 4-9 *" },
    { "path": "/api/editorial-run", "schedule": "0 11 * 4-9 *" },
    { "path": "/api/editorial-run", "schedule": "0 17 * 4-9 *" },

    { "path": "/api/editorial-run", "schedule": "0 7 * 1,2,11,12 *" },
    { "path": "/api/editorial-run", "schedule": "0 12 * 1,2,11,12 *" },
    { "path": "/api/editorial-run", "schedule": "0 18 * 1,2,11,12 *" },

    { "path": "/api/editorial-run", "schedule": "0 6 * 3,10 *" },
    { "path": "/api/editorial-run", "schedule": "0 7 * 3,10 *" },
    { "path": "/api/editorial-run", "schedule": "0 11 * 3,10 *" },
    { "path": "/api/editorial-run", "schedule": "0 12 * 3,10 *" },
    { "path": "/api/editorial-run", "schedule": "0 17 * 3,10 *" },
    { "path": "/api/editorial-run", "schedule": "0 18 * 3,10 *" }
  ]
